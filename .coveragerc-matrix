# Coverage config for the cross-platform test matrix ONLY.
#
# Those runners have no Redis, so every test under tests/live/ skips and
# microguard/live can never execute there. Including it in the measurement does
# not gate that code -- it only drags the reported number down as the live path
# grows, which is exactly what happened: 93% on a branch measured at 100% by a
# job that can actually run the tests.
#
# microguard/live is gated in the `live (Redis-backed)` job instead, which has a
# Redis service container. Between the two jobs, every line is still covered by
# a gate. Local runs use pyproject.toml and measure everything.
#
# The MLflow surface used to be omitted here too, and that was a real gap: it
# was not gated anywhere, because no job installs the mlflow extra. Fixed by
# covering it instead of hiding it -- the wrappers in tracking.py and the
# route in api_mlflow.py are thin delegations, testable with a mocked
# _get_mlflow on any runner. Un-omitting them RAISED this number (98.71% ->
# 99.08%) while making them gated, so there is no tradeoff to weigh.
#
# What genuinely cannot run here is ~30 statements that need mlflow or numpy
# actually imported: tracking.py's `import mlflow`, BotDetectorPyFunc's
# load_context, and train.py's MLflow run block. Adding a ~100MB dependency
# to twelve matrix jobs to reach those is not worth it; they are exercised by
# hand when the Databricks connection is used.
[run]
source = microguard
omit =
    microguard/vulture_whitelist.py
    microguard/live/*

[report]
exclude_lines =
    pragma: no cover
    if __name__ == .__main__.:
    ^\s*\.\.\.$
